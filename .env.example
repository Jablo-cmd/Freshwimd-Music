# Canonical origin used for metadata, sitemap, robots and structured data.
# Leave unset to use the current production domain (https://freshwindmusic.aurisnexus.co.za).
# Only change it when the site really moves to another domain (docs/DOMAIN_SWITCH.md).
# NEXT_PUBLIC_SITE_URL=https://freshwindmusic.aurisnexus.co.za

# Search-engine integration (all optional; nothing is rendered unless a value is set). See docs/SEARCH_CONSOLE_SETUP.md
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=      # Google Search Console HTML-tag verification token (the content value only)
# NEXT_PUBLIC_BING_SITE_VERIFICATION=        # Bing Webmaster Tools msvalidate.01 token
# NEXT_PUBLIC_GA_MEASUREMENT_ID=             # Google Analytics 4 ID, e.g. G-XXXXXXXXXX (enable only with a privacy notice)

# DEVELOPMENT ONLY: set to 1 to preview the portfolio / artist layouts with clearly-labelled
# SAMPLE records (content/sample.ts). Never set this in production.
FWM_SAMPLE_CONTENT=0
